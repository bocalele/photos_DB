#!/bin/bash

APP_BUNDLE="$(cd -- "$(dirname -- "$0")/../.." && pwd)"
FAUNE_DIR="$(cd -- "$APP_BUNDLE/.." && pwd)"
LAUNCHER="$FAUNE_DIR/Lancer Faune.command"

if [[ ! -f "$LAUNCHER" ]]; then
  /usr/bin/osascript -e 'display alert "Lanceur introuvable" message "Le fichier Lancer Faune.command doit se trouver à côté de Faune.app."'
  exit 1
fi

if ! /usr/bin/osascript - "$LAUNCHER" <<'APPLESCRIPT'
on run argv
  set launcherPath to item 1 of argv
  tell application "Terminal"
    activate
    do script "bash " & quoted form of launcherPath
  end tell
end run
APPLESCRIPT
then
  /usr/bin/osascript -e 'display alert "Impossible de lancer Faune" message "Vérifiez l’autorisation d’automatisation de Terminal dans Réglages Système > Confidentialité et sécurité."'
  exit 1
fi
