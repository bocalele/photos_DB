#!/bin/bash

APP_BUNDLE="$(cd -- "$(dirname -- "$0")/../.." && pwd)"
SELECTION_DIR="$(cd -- "$APP_BUNDLE/.." && pwd)"
LAUNCHER="$SELECTION_DIR/Lancer Sélection.command"

if [[ ! -f "$LAUNCHER" ]]; then
  /usr/bin/osascript -e 'display alert "Lanceur introuvable" message "Le fichier Lancer Sélection.command doit se trouver à côté de Selection.app."'
  exit 1
fi

if ! /usr/bin/osascript - "$LAUNCHER" <<'APPLESCRIPT'
on run argv
  set launcherPath to item 1 of argv
  tell application "Terminal"
    activate
    do script "bash " & quoted form of launcherPath
  end tell
end run
APPLESCRIPT
then
  /usr/bin/osascript -e 'display alert "Impossible de lancer Sélection" message "Vérifiez l’autorisation d’automatisation de Terminal dans Réglages Système > Confidentialité et sécurité."'
  exit 1
fi
